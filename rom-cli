#!/usr/bin/env bash
#
# rom-cli — browse and download legal ROMs, homebrew and public-domain
#           games from the Internet Archive, ani-cli style.
#
# Dependencies: curl, jq, fzf, aria2 (aria2c)
# License: GPL-3.0
#
# This tool ONLY queries the public Internet Archive API. It does not
# scrape, bypass, or access any copyrighted/commercial ROM sources.

set -euo pipefail

VERSION="1.1.1"

# ----------------------------------------------------------------------------
# Config
# ----------------------------------------------------------------------------
: "${ROM_CLI_DOWNLOAD_DIR:=${XDG_DOWNLOAD_DIR:-$HOME/Downloads}/roms}"
: "${ROM_CLI_CONNECTIONS:=8}"          # parallel connections per download (aria2 -x)
: "${ROM_CLI_RESULTS:=50}"             # number of search results to fetch

IA_ADVANCED="https://archive.org/advancedsearch.php"
IA_META="https://archive.org/metadata"
IA_DL="https://archive.org/download"

# Collections that are safe / legal: homebrew, public domain, openly-licensed.
# These are the buckets rom-cli searches within. Add your own via -c.
: "${ROM_CLI_COLLECTIONS:=open_source_software;softwarelibrary_misc;homebrew}"

# Optional self-hosted mirror. When set (via --mirror or ROM_CLI_MIRROR),
# rom-cli lists files from an HTTP directory index instead of the IA API.
# Intended for your OWN dumps of games you own, served over your network
# (e.g. an nginx autoindex or FileBrowser raw endpoint).
: "${ROM_CLI_MIRROR:=}"

# ----------------------------------------------------------------------------
# Pretty output
# ----------------------------------------------------------------------------
c_reset=$'\e[0m'; c_dim=$'\e[2m'; c_grn=$'\e[32m'; c_blu=$'\e[34m'; c_red=$'\e[31m'; c_yel=$'\e[33m'
msg()  { printf '%s>>%s %s\n' "$c_grn" "$c_reset" "$*"; }
info() { printf '%s::%s %s\n' "$c_blu" "$c_reset" "$*"; }
warn() { printf '%s!!%s %s\n' "$c_yel" "$c_reset" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$c_red" "$c_reset" "$*" >&2; exit 1; }

# ----------------------------------------------------------------------------
# Dependency check
# ----------------------------------------------------------------------------
check_deps() {
    local missing=()
    for dep in curl jq fzf aria2c; do
        command -v "$dep" >/dev/null 2>&1 || missing+=("$dep")
    done
    if ((${#missing[@]})); then
        die "missing dependencies: ${missing[*]}  (install via: sudo pacman -S ${missing[*]/aria2c/aria2})"
    fi
}

# ----------------------------------------------------------------------------
# Help
# ----------------------------------------------------------------------------
usage() {
    cat <<EOF
${c_grn}rom-cli${c_reset} $VERSION — legal ROM / homebrew downloader (Internet Archive)

${c_yel}USAGE${c_reset}
    rom-cli [options] [search query]
    rom-cli --library COMMAND [options]

${c_yel}OPTIONS${c_reset}
    -d, --download-dir DIR   download target (default: $ROM_CLI_DOWNLOAD_DIR)
    -c, --collection LIST    semicolon-separated IA collections to search
                             (default: $ROM_CLI_COLLECTIONS)
    -m, --mirror URL         use a self-hosted HTTP directory index instead of
                             the Internet Archive (for your OWN dumps)
    -n, --results N          number of search results (default: $ROM_CLI_RESULTS)
    -x, --connections N      parallel connections per download (default: $ROM_CLI_CONNECTIONS)
    -V, --version            print version
    -h, --help               show this help

${c_yel}EXAMPLES${c_reset}
    rom-cli                       # interactive: prompt for a search term
    rom-cli homebrew snes         # search directly
    rom-cli -c opensource_media doom
    rom-cli -m https://example.com/api/raw/roms   # browse your mirror
    rom-cli --mirror http://my-server/roms zelda         # filter your mirror

${c_yel}ENVIRONMENT${c_reset}
    ROM_CLI_DOWNLOAD_DIR, ROM_CLI_COLLECTIONS, ROM_CLI_RESULTS,
    ROM_CLI_CONNECTIONS, ROM_CLI_MIRROR

${c_dim}rom-cli only uses the public Internet Archive API and is intended for
legal, freely-distributable content (homebrew, public domain, openly licensed).${c_reset}
EOF
}

# ----------------------------------------------------------------------------
# Search: query the IA advancedsearch API, restricted to legal collections.
# ----------------------------------------------------------------------------
search_archive() {
    local query="$1"
    # Build a collection filter: (collection:a OR collection:b ...)
    local coll_filter="" IFS=';'
    read -ra colls <<< "$ROM_CLI_COLLECTIONS"
    for col in "${colls[@]}"; do
        [[ -n "$col" ]] || continue
        coll_filter+="${coll_filter:+ OR }collection:${col}"
    done
    unset IFS

    local q="(${query}) AND (${coll_filter})"

    curl -fsSL -G "$IA_ADVANCED" \
        --data-urlencode "q=${q}" \
        --data-urlencode "fl[]=identifier" \
        --data-urlencode "fl[]=title" \
        --data-urlencode "fl[]=year" \
        --data-urlencode "fl[]=mediatype" \
        --data-urlencode "rows=${ROM_CLI_RESULTS}" \
        --data-urlencode "page=1" \
        --data-urlencode "output=json" \
        2>/dev/null
}

# ----------------------------------------------------------------------------
# Pick a result via fzf
# ----------------------------------------------------------------------------
pick_item() {
    local json="$1"
    local count
    count=$(jq -r '.response.numFound // 0' <<<"$json")
    [[ "$count" -gt 0 ]] || return 1

    # tab-separated: identifier \t pretty label
    jq -r '.response.docs[]
            | [.identifier,
               ((.title // .identifier) + "  (" + (.year // "n/a" | tostring) + ")  [" + (.mediatype // "?") + "]")]
            | @tsv' <<<"$json" \
    | fzf --delimiter='\t' \
          --with-nth=2 \
          --prompt='rom > ' \
          --height=80% \
          --border \
          --header="$count results — enter to select, esc to cancel" \
    | cut -f1
}

# ----------------------------------------------------------------------------
# List downloadable files within an IA item, let the user pick which.
# ----------------------------------------------------------------------------
pick_files() {
    local identifier="$1"
    local meta
    meta=$(curl -fsSL "${IA_META}/${identifier}") || die "could not fetch metadata for $identifier"

    # Filter out IA's own metadata/derivative files; keep real content.
    jq -r '.files[]
            | select(.name | test("(_meta\\.xml|_files\\.xml|_meta\\.sqlite|__ia_thumb|\\.sqlite|_archive\\.torrent|reviews\\.xml|_itemimage\\.|spectrogram)") | not)
            | [.name, ((.size // "0") | tonumber)]
            | @tsv' <<<"$meta" \
    | awk -F'\t' '{
        s=$2; u="B";
        if (s>=1073741824){s=s/1073741824;u="GB"}
        else if (s>=1048576){s=s/1048576;u="MB"}
        else if (s>=1024){s=s/1024;u="KB"}
        printf "%s\t%s  (%.1f %s)\n", $1, $1, s, u
      }' \
    | fzf --multi \
          --delimiter='\t' \
          --with-nth=2 \
          --prompt='file > ' \
          --height=80% \
          --border \
          --header="TAB to multi-select files, enter to download" \
    | cut -f1
}

# ----------------------------------------------------------------------------
# MIRROR MODE — list files from a self-hosted HTTP directory index.
#
# Works with any server that emits a standard autoindex of <a href="...">
# links (nginx autoindex on, Apache, Caddy file_server browse, Python
# http.server, FileBrowser raw share, etc). Intended for your OWN dumps.
#
# Recursively walks one level of subdirectories so a layout like
#   /roms/snes/Game.sfc
#   /roms/gba/Game.gba
# is browsable in one search.
# ----------------------------------------------------------------------------
mirror_extract_hrefs() {
    # stdin: HTML index; stdout: one href per line (raw, may be relative)
    grep -oE 'href="[^"]+"' | sed -E 's/^href="//; s/"$//'
}

mirror_list() {
    local base="${ROM_CLI_MIRROR%/}"
    local query="$1"
    local listing=""
    [[ "$base" =~ ^https?:// ]] || die "mirror must use HTTP or HTTPS"

    # Fetch top-level index
    local top
    top=$(curl -fsSL "${base}/") || die "could not reach mirror: $base"

    # Collect entries. Directories (href ending in /) get walked one level deep.
    local href
    while IFS= read -r href; do
        safe_mirror_segment "${href%/}" || continue
        # skip parent/sort links and absolute URLs to elsewhere
        [[ "$href" == "../" || "$href" == "/" || "$href" == \?* ]] && continue
        [[ "$href" == http*://* ]] && continue

        if [[ "$href" == */ ]]; then
            # subdirectory — list its contents
            local subdir="${href%/}"
            local sub
            sub=$(curl -fsSL "${base}/${href}" 2>/dev/null) || continue
            local f
            while IFS= read -r f; do
                safe_mirror_segment "$f" || continue
                [[ "$f" == "../" || "$f" == "/" || "$f" == \?* || "$f" == */ ]] && continue
                [[ "$f" == http*://* ]] && continue
                listing+="${subdir}/${f}"$'\n'
            done < <(printf '%s' "$sub" | mirror_extract_hrefs)
        else
            listing+="${href}"$'\n'
        fi
    done < <(printf '%s' "$top" | mirror_extract_hrefs)

    # URL-decode %20 etc for display matching, filter by query (case-insensitive)
    if [[ -n "$query" ]]; then
        printf '%s' "$listing" | grep -i -F -- "$query" || true
    else
        printf '%s' "$listing"
    fi
}

pick_mirror_files() {
    local query="$1"
    local entries
    entries=$(mirror_list "$query") || return 1
    [[ -n "$entries" ]] || return 0

    printf '%s' "$entries" \
    | sed '/^$/d' \
    | fzf --multi \
          --prompt='rom > ' \
          --height=80% \
          --border \
          --header="mirror: ${ROM_CLI_MIRROR} — TAB multi-select, enter to download" \
    || true
}

safe_mirror_segment() {
    local part="$1" lower="${1,,}"
    [[ -n "$part" && "$part" != .* && "$part" != */* && "$part" != *\\* &&
       "$part" != *[[:cntrl:]]* && "$part" != *'?'* && "$part" != *'#'* &&
       "$part" != *:* && "$lower" != *%2f* && "$lower" != *%5c* &&
       "$lower" != *%2e* && "$lower" != *%25* ]]
}

# A private staging directory prevents aria2 from resuming an unrelated file.
# Link publication fails atomically when the chosen leaf already exists.
download_one() (
    set -e
    local dest="$1" out="$2" url="$3" stage
    [[ -n "$out" && "$out" != .* && "$out" != */* && "$out" != *\\* &&
       "$out" != *[[:cntrl:]]* ]] || die "invalid output filename"
    [[ ! -L "$dest" ]] || die "linked download directory"
    mkdir -p -- "$dest"
    [[ ! -e "$dest/$out" && ! -L "$dest/$out" ]] || die "file already exists: $out"
    stage=$(mktemp -d -- "$dest/.rom-cli-XXXXXXXX")
    trap 'rm -f -- "$stage/payload" "$stage/payload.aria2"; rmdir -- "$stage"' EXIT
    aria2c --no-conf=true --follow-torrent=false --follow-metalink=false \
        --dir="$stage" --out=payload --max-connection-per-server="$ROM_CLI_CONNECTIONS" \
        --split="$ROM_CLI_CONNECTIONS" --auto-file-renaming=false --allow-overwrite=false \
        --summary-interval=0 --console-log-level=warn -- "$url"
    ln -T -- "$stage/payload" "$dest/$out"
)

download_mirror_files() {
    local rel base="${ROM_CLI_MIRROR%/}" dest="${ROM_CLI_DOWNLOAD_DIR}/mirror"
    for rel in "$@"; do
        msg "downloading: $rel"
        download_one "$dest" "${rel##*/}" "$base/$rel"
    done
    msg "done → $dest"
}

download_files() {
    local identifier="$1" f encoded dest
    shift
    [[ "$identifier" =~ ^[A-Za-z0-9_-][A-Za-z0-9._-]*$ ]] || die "invalid item identifier"
    dest="${ROM_CLI_DOWNLOAD_DIR}/${identifier}"
    for f in "$@"; do
        [[ "$f" != /* && "$f" != *\\* && "/$f/" != *'/../'* && "/$f/" != *'/./'* ]] || die "invalid item path"
        encoded=$(jq -rn --arg name "$f" '$name | split("/") | map(@uri) | join("/")')
        msg "downloading: $f"
        download_one "$dest" "${f##*/}" "$IA_DL/$identifier/$encoded"
    done
    msg "done → $dest"
}

# ----------------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------------
main() {
    if [[ ${1:-} == --library ]]; then
        shift
        local base
        base=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")
        exec python3 -I "$base/library-entry.py" "$@"
    fi
    local query=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d|--download-dir) ROM_CLI_DOWNLOAD_DIR="$2"; shift 2;;
            -c|--collection)   ROM_CLI_COLLECTIONS="$2"; shift 2;;
            -m|--mirror)       ROM_CLI_MIRROR="$2"; shift 2;;
            -n|--results)      ROM_CLI_RESULTS="$2"; shift 2;;
            -x|--connections)  ROM_CLI_CONNECTIONS="$2"; shift 2;;
            -V|--version)      echo "rom-cli $VERSION"; exit 0;;
            -h|--help)         usage; exit 0;;
            --) shift; query="$*"; break;;
            -*) die "unknown option: $1";;
            *)  query="${query:+$query }$1"; shift;;
        esac
    done

    check_deps

    # ---- Mirror mode: list from a self-hosted HTTP index ----
    if [[ -n "$ROM_CLI_MIRROR" ]]; then
        if [[ -z "$query" ]]; then
            read -rp "$(printf '%s::%s filter (leave empty for all): ' "$c_blu" "$c_reset")" query
        fi
        info "browsing mirror: $ROM_CLI_MIRROR"
        local mchosen selection
        selection=$(pick_mirror_files "$query") || die "mirror listing failed"
        [[ -n "$selection" ]] || { warn "nothing selected"; exit 0; }
        mapfile -t mchosen <<< "$selection"
        download_mirror_files "${mchosen[@]}"
        return
    fi

    # ---- Default: Internet Archive ----
    if [[ -z "$query" ]]; then
        read -rp "$(printf '%s::%s search: ' "$c_blu" "$c_reset")" query
        [[ -n "$query" ]] || die "no search query"
    fi

    info "searching Internet Archive for: $query"
    local results
    results=$(search_archive "$query") || die "search failed"

    local id
    id=$(pick_item "$results") || die "no results found (try a broader query or a different -c collection)"
    [[ -n "$id" ]] || { warn "cancelled"; exit 0; }

    info "selected: $id"
    [[ "$id" =~ ^[A-Za-z0-9_-][A-Za-z0-9._-]*$ ]] || die "invalid item identifier"
    local chosen selection rc
    selection=$(pick_files "$id") || {
        rc=$?
        [[ $rc == 130 ]] && { warn "cancelled"; exit 0; }
        die "could not select item files"
    }
    [[ -n "$selection" ]] || { warn "no files selected"; exit 0; }
    mapfile -t chosen <<< "$selection"

    download_files "$id" "${chosen[@]}"
}

main "$@"
